{
  "required": true,
  "minVersion": "0.8",
  "package": "${group}.${mod_id}.mixin",
  "compatibilityLevel": "JAVA_${java_version}",
  "mixins": [
    "HolderReferenceMixin",
    "PackRepositoryMixin",
    "RegistryDataLoaderMixin",
    "ServerPacksSourceMixin"
  ],
